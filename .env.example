# ===== 宿主机发布端口（容器内前端/nginx 固定监听 8080）=====
# 由验证环境注入 CC_PUBLISH_PORT；本地直接 docker compose up 时可取消注释自定义
# CC_PUBLISH_PORT=3032

# ===== Compose 项目名（验证环境已固定，一般无需修改）=====
# COMPOSE_PROJECT_NAME=task2026-09-1232

# ===== MySQL 配置（仅内网，不发布宿主端口）=====
DB_NAME=vaxdb
DB_USER=vax
DB_PASSWORD=vaxpass
DB_ROOT_PASSWORD=rootpass

# ===== 后端 JWT 密钥（生产环境务必修改，长度 >= 64 字符）=====
VAX_JWT_SECRET=community-vaccine-platform-demo-jwt-secret-key-please-change-in-prod-0123456789
